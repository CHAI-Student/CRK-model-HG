# CRK-model-HG 환경 설정 예시 — 냉장(refrigerated, top+side dual) 기기용
#
# 사용법: 이 파일을 .env로 복사한 뒤 기기에 맞게 수정한다.
#   cp refrg.env.example .env
# .env는 serve.py(model-service-hg 기동)가 자동 로드한다. 이미 export된
# 환경변수가 있으면 그것이 우선한다 (os.environ.setdefault).
#
# freezer.env.example과의 구조 차이 (2026-07-28 냉장 실기 결정):
# - CABINET_TYPE=refrigerated — 냉장 프로파일(±5g, strict 무게 판정)
# - CAMERA_LAYOUT=dual(기본) — side는 실제 측면 뷰 (dual_top_proxy 아님)
# - SIDE_CROP=left — side 카메라는 존이 화면 왼쪽에 있어 640×480에서
#   x=0..480 left-crop (원본 엔진 좌표계 복원. top은 항상 center-crop)
# - SIDE_ROI_MAX_CENTER_X=300 — left-crop 좌표계에서 좌 0~300만 판정에 사용

# ============================================================================
# 필수 — 기기마다 반드시 확인
# ============================================================================

# TensorRT 엔진 경로 (레포에 없음 — CRK-model에서 쓰던 .engine 복사)
MODEL__VISION__YOLO_MODEL_PATH=models/set9_doorfas_0323_imbal.engine

# 기기 캐비닛 타입: refrigerated | freezer
# 냉장 기기는 refrigerated — 존 프로파일(±5g)·strict 판정·조기 종료 활성의
# 기준이 된다. 냉동 기기는 freezer.env.example을 쓸 것.
MODEL__MACHINE__CABINET_TYPE=refrigerated
# 냉장 실기는 side가 실제 측면 뷰 — 기본값과 같지만 명시해 둔다
# (dual_top_proxy는 냉동 실기 전용: side 스트림도 top 뷰).
MODEL__VISION__CAMERA_LAYOUT=dual

# ============================================================================
# 카메라 기하 (2026-07-28 냉장 실기)
# ============================================================================
# side 카메라 크롭 원점: center(기본) | left.
# 냉장 side는 존이 화면 왼쪽 — 640×480 소스에서 왼쪽 0~480px left-crop
# (원본 엔진 좌표계와 동일). top 카메라는 항상 center-crop(좌우 80px 제거).
# 이 값은 판정 좌표계 그 자체이므로 SIDE_ROI 경계와 함께 움직여야 한다.
# 아카이브(camera_crops)에 스탬프되어 render-session이 같은 기하로 재현한다.
MODEL__VIDEO__SIDE_CROP=left

# ============================================================================
# 비전 투표 튜닝 (세션 아카이브 YAML의 vote_summary를 보고 조정)
# ============================================================================
# 판정 흐름: YOLO 검출 → (진입 컷) → 투표 누적 → (ratio/count 게이트)
#            → (conf_floor) → vision_candidates → strict 판정
# vote_summary 읽는 법:
#   entry_dropped_by_camera 큼  → 진입 컷이 너무 높음 (아래 THRESHOLD 낮추기)
#   rejected_by: "ratio"        → 투표 수 부족 (MIN_VOTE_RATIO/COUNT 낮추기)
#   rejected_by: "conf_floor"   → 결합 후 하한에 걸림 (CONF_FLOOR 낮추기)
#   filter_drops_by_stage 큼    → side_roi/hand_path 필터가 지움 (ROI 경계 확인)
#   classes 자체가 비어 있음    → 모델이 정말 못 봄 (모델/카메라 문제)

# 카메라별 투표 진입 임계 — 이 conf 미만 검출은 투표에 안 들어감.
# 원본 코드 기본 0.70, 원본 운영 .env.example 0.50 — 냉장 초기값은 원본
# 운영값에서 출발한다 (냉동의 0.4는 김서림·성에 보정치라 이식하지 않음).
# SAVE_DETECTIONS 오버레이에는 이 값 이상의 검출만 기록/표시된다.
MODEL__VISION__TOP_CONFIDENCE_THRESHOLD=0.50
MODEL__VISION__SIDE_CONFIDENCE_THRESHOLD=0.50

# 후보 채택 임계: 투표율(votes/게이트 통과 프레임) 또는 절대 투표 수 중 하나만
# 넘으면 후보 유지. 원본 운영값 ratio 0.02 / count 1 (코드 기본 0.05 / 3).
# 조기 종료가 도는 냉장은 게이트 통과 프레임이 짧을 수 있어 냉동과 같은
# 0.02/2에서 출발 — 노이즈 후보가 살아남으면 0.05/3으로 올려 본다.
MODEL__VISION__MIN_VOTE_RATIO=0.02
MODEL__VISION__MIN_VOTE_COUNT=2

# vote_ratio 분모 정의 (이슈 #18 후속). "gate"(기본) = 전 카메라 게이트 통과
# 프레임 합 — 분자(취출 순간의 표)는 영상 길이와 무관한데 분모가 프리롤·
# 포스트롤·타카메라 프레임까지 세서 정답 클래스 ratio가 0.03~0.07로
# 플리커 수준까지 희석된다 (실기 ses-6: 49가 10표/186 = 0.054).
# "hand_window" = 손 활성(손 검출 ∨ 래치 열림) 프레임 합 — "취출이 보일 수
# 있었던 프레임"만 세는 길이 불변 밀도. 손을 전혀 못 본 카메라는 자기 게이트
# 통과 수로 폴백한다. 켜면 ratio 절대값이 2~4배 올라가므로 MIN_VOTE_RATIO를
# 0.10~0.15로 함께 올려야 채택 문턱이 같은 수준으로 유지된다. 아카이브에는
# vote_summary.ratio_denominator로 스탬프되어 과거 세션과 구분된다.
MODEL__VISION__VOTE_RATIO_DENOMINATOR=gate

# 1위 후보 득표 대비 상대 하한 (이슈 #10). 절대 COUNT는 긴 영상에서 노이즈도
# 통과시킨다 — votes < 1위×SHARE 후보 제거. 0 = 비활성.
# vote_summary의 rejected_by: "share"로 제거 여부 확인 가능.
MODEL__VISION__MIN_VOTE_SHARE=0.1

# 결합 후 weighted_conf 하한 — 원본에는 없는 안전판 (원본 동형 = 0.0).
# 진입 컷을 0으로 낮춰 저신뢰 투표까지 보존할 때만 0.1~0.4로 올려 쓴다.
MODEL__VISION__CONF_FLOOR=0.0

# 카메라 conf 결합 가중 (원본 combine() 동형 산식 — P1-4):
#   양카메라 검출: weighted = top·W_TOP + side·W_SIDE
#                            + min(top,side)·COMMON_CLASS_BONUS
#   단일 카메라:   weighted = conf·W_TOP_ONLY (또는 W_SIDE_ONLY)
# 냉장 초기값은 원본 운영값(0.60/0.40/0.2) — 냉동 템플릿의 0.70/0.30은
# dual-top 실기 보정치라 이식하지 않는다. 실측 후 조정.
MODEL__VISION__CONF_WEIGHT_TOP=0.60
MODEL__VISION__CONF_WEIGHT_SIDE=0.40
MODEL__VISION__CONF_WEIGHT_TOP_ONLY=0.60
MODEL__VISION__CONF_WEIGHT_SIDE_ONLY=0.40
MODEL__VISION__CONF_COMMON_CLASS_BONUS=0.2

# Side 카메라 ROI 경계 (center_x >= 이 값이면 존 바깥으로 보고 제거).
# 좌표계는 **left-crop 480×480** (위 SIDE_CROP=left와 한 몸) — 왼쪽 0부터
# 300까지만 판정에 사용한다 (2026-07-28 냉장 실기 사용자 결정).
# SIDE_CROP을 center로 바꾸면 이 경계도 재측정해야 한다 (원점이 80px 이동).
# vote_summary의 filter_drops_by_stage.side_roi로 제거량 확인.
MODEL__VISION__SIDE_ROI_MAX_CENTER_X=300

# 수직 ROI (P1-5): 냉동 dual-top(cabinet=freezer ∧ CAMERA_LAYOUT=
# dual_top_proxy) 전용이라 냉장 dual에서는 미적용 — 설정하지 않는다.

# 냉장(top+side) 레이아웃 top 카메라 수직 ROI (원본 top_roi_enabled) —
# 트리거 delta가 0이 아닐 때 하단(center_y >= Y_SPLIT)만 유지. 원본 냉장
# 기본은 on이지만 HG는 보수적으로 off에서 출발 — 실기 vote_summary의
# filter_drops_by_stage.vertical_roi와 오검출 양상을 보고 켤 것.
MODEL__VISION__TOP_ROI_ENABLED=0
MODEL__VISION__TOP_ROI_Y_SPLIT=240.0

# 손 검출 conf 하한 (원본 hand_confidence_threshold, P1-7 이식) — 이 값
# 미만의 hand 검출은 모션 게이트 래치(I16)·hand_path 궤적에 쓰지 않는다.
# 원본 운영값 0.30. 0 = 비활성.
MODEL__VISION__HAND_CONFIDENCE_THRESHOLD=0.30

# side 카메라 hand 추론 (이슈 #18, 원본에 없는 신설 — 기본 off = 원본 동작).
# 켜면 side allowlist에 hand(0)가 포함되고, side에서도 래치(I16)와
# hand_path 손 근접 필터가 자동으로 작동한다 — 정지 진열 상품의 배경성
# 오투표(예: side zone1 class43 450건/평균 conf 0.21)를 손 근처만 남겨 거르는
# 것이 목적. 관측 지표: vote_summary의 filter_drops_by_stage.hand_path.side
# (급증 시 손 오탐이 진짜 상품을 지우고 있다는 신호), gate_skipped.side 감소
# (래치로 side 추론량 증가 → 지연 상승).
MODEL__VISION__SIDE_HAND_ENABLED=0

# side 전용 손 conf 하한 — side는 손 검출 1건이 hand_path 필터를 무장시키는
# 방아쇠라서 top(HAND_CONFIDENCE_THRESHOLD)보다 조일 수 있게 분리했다.
# 음수 = HAND_CONFIDENCE_THRESHOLD 상속(기본).
MODEL__VISION__SIDE_HAND_CONFIDENCE_THRESHOLD=-1.0

# ============================================================================
# 로드셀 판정
# ============================================================================
# 오염 delta 이중 타깃 재시도 (이슈 #10): 접촉 하중으로 delta와 세그먼트 합이
# 어긋나고(실측 8~18g) delta 타깃 판정이 실패하면 세그먼트 합으로 1회 재판정.
MODEL__WEIGHT__SEGMENT_RETRY_GAP_GRAMS=5.0

# 로드셀 안정 판정 (이슈 #14, 0.8s 캐던스)
# STABLE_WINDOW는 ANALYZER=plateau(롤백)일 때만 효력 — bocpd는 미사용
MODEL__WEIGHT__STABLE_WINDOW=3
MODEL__WEIGHT__STABILITY_THRESHOLD_GRAMS=2.5

# primary 로드셀 분석기: bocpd (2026-07-23 정식 승격) — 회귀 시 plateau 롤백
MODEL__LOADCELL__ANALYZER=bocpd

# ============================================================================
# 판정 노브 — 냉장 기본은 strict(무게=정체성 ±5g) 판정이라 아래
# FreezerVisionFirst 계열(I-V) 노브는 freezer 프로파일 존(MODEL__ZONES__
# FREEZER 오버라이드)에만 적용된다. 혼합 기기 대비 냉동 템플릿과 동일값 유지.
# ============================================================================
MODEL__JUDGMENT__SINGLE_SHARE=0.5
MODEL__JUDGMENT__COMBO_SHARE=0.3
MODEL__JUDGMENT__NEAR_FACTOR=2.0
MODEL__JUDGMENT__REFIT_SHARE=0.1
MODEL__JUDGMENT__COUNT_UNIT_SLACK=5.0
MODEL__JUDGMENT__CONF_OVERRIDE=0.9
MODEL__JUDGMENT__CONF_MARGIN=0.15
MODEL__JUDGMENT__REFIT_ARB_CONF_FLOOR=0.8

# 무게 미검증 count=1 partial 청구의 conf 하한 (저증거 청구 차단)
MODEL__JUDGMENT__PARTIAL_MIN_CONFIDENCE=0.18

# ============================================================================
# 조기 종료 · 모션 게이트 (프레임 처리량)
# ============================================================================
# EARLY_TERMINATION: removal & 비freezer 한정 — 냉장에서는 실제로 동작한다
# (freezer 프로파일 존은 I15로 항상 비활성).
MODEL__VISION__EARLY_TERMINATION=1
# 모션 변위 증거 (원본 MOTION_MIN_DISPLACEMENT_PX 이식): FLOOR 비우면 냉장
# 프로파일 기본 10px — 픽셀 임계라 1:1 크롭이면 crop 원점과 무관하게 유효.
MODEL__VISION__MOTION_EVIDENCE=1
# MODEL__VISION__MOTION_EVIDENCE_FLOOR_PX=

# no_motion 몰수의 "측정 불가" 정책 (이슈 #18 후속). 관측 1회 트랙은
# path=0이라 변위 통과가 구조적으로 불가능 — 빠른 취출은 검출이 1~2프레임
# 이거나 트랙 단편화로 전부 그 상태가 되어, 정답 표가 "너무 빨리 움직여서
# no_motion"으로 몰수되는 역설이 생긴다. forfeit(기본) = 현행 몰수.
# exempt = 측정 가능한(관측 ≥ MEASURABLE_MIN_OBS) 트랙이 하나도 없는
# 클래스는 면제 — "측정된 정지"(진열, 장수 트랙 path≈0)는 계속 몰수된다.
# 승격 판단 재료: vote_summary classes의 rejected_by "no_motion_unmeasurable"
# (측정 불가 몰수)이 정답 클래스에서 반복되는지 + motion_evidence 항목의
# unmeasurable: true 마킹.
MODEL__VISION__MOTION_UNMEASURABLE=forfeit
# MODEL__VISION__MOTION_MEASURABLE_MIN_OBS=3
# T2 held 트랙 강등 — 냉동과 동일한 shadow-first 방침
# (vote_summary.held_shadow 관측 → analyze-sessions 라벨 대조 후 승격).
MODEL__VISION__HELD_TRACK_DEMOTION=shadow
MODEL__VISION__HELD_TRACK_MIN_HEAD=5
# MOTION_GATE_*: 비우면 냉장 프로파일 기본(0.02/8) 유지.
# MODEL__VISION__MOTION_GATE_THRESHOLD=
# MODEL__VISION__MOTION_GATE_KEEPALIVE=

# ============================================================================
# 교차존 비전 오염 페널티 (docs/devdoc/design/cross_zone_penalty.md, CLOSE 2차 패스)
# ============================================================================
MODEL__CROSS_ZONE__PENALTY_ENABLED=1
MODEL__CROSS_ZONE__REPLAY_S=4.0
MODEL__CROSS_ZONE__TRIGGER_S=4.0
MODEL__CROSS_ZONE__EPSILON_S=1.0
MODEL__CROSS_ZONE__ALPHA=0.5
# 0.35 권장 — 0.5는 저conf 난장 장면에서 기제 전체를 끈다 (9차 ses-8)
MODEL__CROSS_ZONE__SOURCE_CONF_MIN=0.35

# ============================================================================
# 세션 고스트 원장 (0723 이슈 #17 P1, CLOSE 2차 패스)
# ============================================================================
MODEL__GHOST__MODE=shadow
MODEL__GHOST__MIN_ZONES=2
MODEL__GHOST__VOTE_FLOOR=3
MODEL__GHOST__ALPHA=0.5

# ============================================================================
# 존 프로파일 (선택)
# ============================================================================
# 냉장 기기에서 특정 존만 냉동으로 오버라이드할 때 사용
# MODEL__ZONES__FREEZER=9,10

# ============================================================================
# 비디오 디코더
# ============================================================================
# auto | ffmpeg | opencv — auto는 NVDEC(hwaccel cuda)+numpy 가용 시 ffmpeg 스트리밍
MODEL__VIDEO__DECODER=auto

# ============================================================================
# CLOSE 정산 타이밍
# ============================================================================
MODEL__CLOSE__BARRIER_TIMEOUT_S=10.0
MODEL__CLOSE__GRACE_S=3.0
MODEL__CLOSE__WORKER_STALL_TIMEOUT_S=120.0
# freezer close 재solve 전용 (이슈 #17) — 냉장 존에는 무영향, 혼합 기기 대비 유지
MODEL__CLOSE__VISION_COMBO=1
# 콤보 자격 5중 가드 (2026-07-27 12~14차 배치: 콤보가 정답 판정을 뒤집는
# 오과금 6건 대응 — 실패 방향은 전부 "콤보 미형성 = 비전 판정 유지"로 fail-safe).
# ① 실존 증거 하한: 소수 클래스는 top 대비 득표율 ≥ RATIO **또는** conf ≥ CONF
#    (오분류 플리커 7~9표가 정상 ×N 스냅을 쪼개는 사고 차단). RATIO=0으로 비활성.
# ② 세션 관측 가드: 고스트로 검출된 클래스, 타 존의 무게 뒷받침 과금이 이미
#    설명한 클래스는 콤보 재료 금지 (동시 멀티존 취출의 공유 영상 표 유입 차단).
# ③ 확신 스냅 보호: 게이트 안 스냅을 콤보가 뒤집으려면 존 판정 conf가
#    OVERRIDE_MAX_CONF 미만이어야 한다 (오버라이드 오답 6건 전부 conf 0.96~1.0,
#    보호해야 하는 앨리어싱 구제 케이스는 0.72~0.9 — 실측 분리선). >1로 비활성.
MODEL__CLOSE__COMBO_MIN_VOTE_RATIO=0.5
MODEL__CLOSE__COMBO_MIN_CONF=0.8
MODEL__CLOSE__COMBO_SESSION_GUARD=1
MODEL__CLOSE__COMBO_OVERRIDE_MAX_CONF=0.95

# ============================================================================
# 세션/원장/아카이브
# ============================================================================
# 에러 트리거 포함 세션의 결제 정책 (D9/I13): block_payment (fail-closed)
MODEL__SESSION__ERROR_POLICY=block_payment
# 세션 YAML 아카이브 (오판정 사후 분석용) — 빈 문자열이면 비활성
MODEL__SESSION__ARCHIVE_DIR=data/sessions
MODEL__SESSION__ARCHIVE_RETENTION_DAYS=14
# 프레임별 bbox 기록 (검출 품질 시각 검증): 추론 프레임에서 판정 로직에
# 실제 기여한 검출(필터 체인 통과 ∧ 투표 진입 conf 이상, hand는 체인 통과분)
# 만 아카이브에 동봉 → 실기 결제 후 `render-session --latest`로 AVI 위
# 오버레이 영상 생성. 기본 0 — 필드테스트 기간에만 켠다
# (아카이브 용량 증가: 트리거당 수십~수백 KB).
MODEL__SESSION__SAVE_DETECTIONS=0
# 이벤트 저널 (JSONL, 일자 로테이션)
MODEL__LEDGER__JOURNAL_PATH=logs/events.jsonl
MODEL__LEDGER__JOURNAL_RETENTION_DAYS=14
# EventLog/settler 멱등 캐시 보존 세션 수 (I11)
MODEL__LEDGER__KEEP_SESSIONS=4

# ============================================================================
# 트리거/서버/로깅
# ============================================================================
MODEL__TRIGGER__IDEMPOTENCY_TTL_S=5.0
MODEL__TRIGGER__OUTCOMES_KEEP=256
# TensorRT 마이크로배치 (T2-2, docs/devdoc/research/0728_freezer_latency_research.md):
# >1이면 게이트 통과 프레임을 N장 모아 detect_batch 1회로 추론 (GPU 텐서
# 직접 투입 — 프레임당 CPU 전처리 소멸). **정적 batch 엔진 재수출 필수**:
#   BATCH=4 bash scripts/convert_engine.sh   # → models/{stem}_batch4.engine
# 재수출 엔진은 batch 접미사가 붙으므로 위 YOLO_MODEL_PATH도 같은 파일로
# 바꿔야 한다 — BATCH_SIZE·엔진 파일 짝이 어긋나면 기동 프로브가 즉시
# 실패한다 (무증상 기동 금지).
MODEL__VISION__BATCH_SIZE=1
# 카메라별 선행 디코드 깊이 (T2-3): 0=비활성. 4 권장 시작값 — top 추론 중
# side 디코드 은닉, 메모리 깊이×691KB/카메라.
MODEL__VIDEO__PREFETCH=0
# T2-1 단독 스위치: BATCH_SIZE=1(기존 batch-1 엔진 그대로, 재수출 불필요)
# 에서도 추론을 GPU 전처리 텐서 경로로 보낸다 — 전처리 소멸 효과만 분리
# 측정용. BATCH_SIZE>1이면 배치 경로가 이미 텐서 투입이라 무의미.
MODEL__VISION__TENSOR_INPUT=0
MODEL__SERVER__HOST=0.0.0.0
MODEL__SERVER__PORT=8002
MODEL__LOG_LEVEL=INFO
